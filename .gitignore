# Build outputs
/target/
**/target/
*.wasm

# Never-commit artifacts (same guards as the monorepo)
*.orig
*.pyd
__pycache__/
vendor/

# Editor / OS cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Prebuilt static libs are stray build output: the vendored tree-sitter
# build.rs compiles lib.c from source into OUT_DIR and never reads these.
*.a
